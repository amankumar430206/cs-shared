{
  "name": "@castadi/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-neutral CASTADI types, zod schemas, design tokens, API client and react-query hooks shared by cs-mobile (and later cs-web).",
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./types": { "types": "./dist/types/index.d.ts", "import": "./dist/types/index.js" },
    "./schemas": { "types": "./dist/schemas/index.d.ts", "import": "./dist/schemas/index.js" },
    "./tokens": { "types": "./dist/tokens/index.d.ts", "import": "./dist/tokens/index.js" },
    "./api": { "types": "./dist/api/index.d.ts", "import": "./dist/api/index.js" },
    "./hooks": { "types": "./dist/hooks/index.d.ts", "import": "./dist/hooks/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@types/react": "^19",
    "react": "19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
